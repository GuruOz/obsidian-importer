# Copy this file to .env and fill in the blanks. chmod 600 .env on Linux hosts.
# Paths below are container-internal paths; do not change unless you also edit
# docker-compose.yml / the Dockerfile.
#
# Pipeline runs re-read this file at run start, so edits (or dashboard saves)
# apply from the next run without recreating containers. Format notes:
#   - one KEY=VALUE per line, value taken literally (no $-expansion); don't
#     quote values - only one surrounding quote pair would be stripped, and
#     Compose and the run-time reader may disagree on anything fancier
#   - to disable a setting, set it empty (KEY=) rather than deleting the line:
#     a deleted line leaves the old container-creation value active until the
#     next `docker compose up -d`
#   - never define INGEST_ENV_OVERRIDES here - it is per-run plumbing and is
#     ignored if present
# Exceptions: the chat assistant (vault-qa) and the WhatsApp bridge read their
# settings at container creation - apply those with `docker compose up -d`.

# --- Paths (container-internal, leave as-is) ---
VAULT_DIR=/vault
WORKDIR=/work
STAGING_DIR=/work/staging
LOG_DIR=/work/logs
LEDGER_FILE=/work/processed_ids.txt
MSAL_CACHE_FILE=/work/msal_cache.json

# --- Microsoft Graph (replaces IMAP - see README "Email access" section) ---
# One-time Entra app registration (free, personal Microsoft account):
#   1. https://portal.azure.com -> Microsoft Entra ID -> App registrations -> New registration
#   2. Supported account types: "Personal Microsoft accounts only"
#   3. Authentication -> Advanced settings -> "Allow public client flows" = Yes
#   4. API permissions -> Add -> Microsoft Graph -> Delegated -> Mail.Read -> Grant
#   5. Copy the "Application (client) ID" below
GRAPH_CLIENT_ID=
GRAPH_TENANT=consumers

# --- Copilot email matching ---
DIGEST_FROM=
DIGEST_SUBJECT_PATTERN=
#   Ad-hoc work notes: emails from the same sender whose subject matches this
#   pattern are filed as free-form work notes (into that day's daily journal
#   entry plus any matching topic notes) instead of being parsed as a daily
#   summary. Route them into DIGEST_FOLDER with a mail rule, same as digests.
#   Blank disables ad-hoc notes. Default: obsidian note
#DIGEST_NOTE_SUBJECT_PATTERN=obsidian note
# Folder the pipeline reads from. Set up an Outlook.com rule that moves incoming
# digests into this folder (keeps your inbox clean and lets the app stay read-only).
# Use "Inbox" if you don't want a rule. A folder created inside the Inbox is
# "Inbox/FolderName"; other nesting works the same way ("Parent/Child").
DIGEST_FOLDER=Inbox/CopilotDigest
#   Max tool-calling turns the filing agent gets. Real multi-workstream digests
#   regularly exhaust the built-in 30 (the agent then files what it can but never
#   reports a summary, logged as "unreported" in the Filing Log) - 60 is a safer
#   working value. More loops = more tokens, but only when actually used.
#DIGEST_MAX_LOOPS=60

# --- Personal inbox triage (second ingestion source: run-ingest.sh personal) ---
# Reads your whole Inbox (same Mail.Read token, still read-only), lets the agent
# triage each new email, and files the ones worth keeping. Starts from "now" on its
# first run (nothing before today is ever ingested) unless a lookback is set. All
# keys are optional - the defaults below are the built-ins; uncomment only to
# override.
#   Per-source DRY_RUN: keep personal mail proposing-only (proposed.md) while the
#   digest files live. Defaults to 1 (safe) and does NOT follow the global DRY_RUN.
#PERSONAL_MAIL_DRY_RUN=1
#PERSONAL_MAIL_FOLDER=Inbox
#PERSONAL_MAIL_MAX_PER_RUN=25
#   Max tool-calling turns the triage/filing agent gets per pass (more = more tokens).
#PERSONAL_MAIL_MAX_LOOPS=30
#   How far back to process email, in days. 0 = only mail arriving after setup.
#   Raising it later rewinds the start point and backfills older mail (capped at
#   MAX_PER_RUN per night; already-processed emails are never re-filed). Lowering
#   it never skips forward past unprocessed mail.
#PERSONAL_MAIL_LOOKBACK_DAYS=0
#   One-shot explicit window (YYYY-MM-DD, local time, end date inclusive):
#   ingest only mail received inside the window and leave the nightly watermark
#   untouched (the ledger still prevents re-filing). END requires START; empty
#   END means "until now". Normally set per-run from the settings page rather
#   than here - if set here, EVERY run uses the window, so remember to unset.
#PERSONAL_MAIL_START_DATE=
#PERSONAL_MAIL_END_DATE=
#PERSONAL_MAIL_STAGING_DIR=/work/staging/personal
#PERSONAL_MAIL_LEDGER_FILE=/work/personal_processed_ids.txt
#PERSONAL_MAIL_WATERMARK_FILE=/work/personal_watermark.txt
#   Optional: point personal mail at a different (even local) LLM without touching
#   the digest. Defaults to the global LLM_* vars below.
#PERSONAL_MAIL_LLM_BASE_URL=
#PERSONAL_MAIL_LLM_API_KEY=
#PERSONAL_MAIL_LLM_MODEL=

# --- Telegram (third ingestion source: run-ingest.sh telegram) ---
# Reads your Telegram chats via a user session (Telethon/MTProto - the Bot API
# can't read personal chats). One-time setup: create API credentials at
# https://my.telegram.org (API development tools) and paste them below, then log
# in from the dashboard Telegram page (or `docker compose exec -it pipeline
# python3 scripts/telegram_login.py`). Read-only: the pipeline never sends.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
#   Keep proposing-only (proposed.md) until placement quality looks good. Default 1.
#TELEGRAM_DRY_RUN=1
#   Include/exclude by chat title, @username, or numeric id (comma-separated,
#   case-insensitive). A non-empty INCLUDE list is an allowlist (named chats win
#   over the type toggles below). Copy exact names from the dashboard's
#   discovered-chats list (written to data/telegram/chats.json).
#TELEGRAM_INCLUDE_CHATS=
#TELEGRAM_EXCLUDE_CHATS=
#   Chat-type toggles (one-to-one chats are always eligible).
#TELEGRAM_INCLUDE_GROUPS=1
#TELEGRAM_INCLUDE_CHANNELS=0
#TELEGRAM_INCLUDE_BOTS=0
#   Max messages staged per run (a backlog drains across nights/passes).
#TELEGRAM_MAX_PER_RUN=500
#   Max tool-calling turns the filing agent gets per pass.
#TELEGRAM_MAX_LOOPS=60
#   Nightly watermark seed: how far back to start on the FIRST run, in days.
#   0 = only messages arriving after setup.
#TELEGRAM_LOOKBACK_DAYS=0
#   One-shot explicit window (YYYY-MM-DD Singapore days, end inclusive; START may
#   be "all" for the whole history) - a stateless backfill that leaves the nightly
#   watermark untouched. Normally set per-run from the dashboard, not here.
#TELEGRAM_START_DATE=
#TELEGRAM_END_DATE=
#TELEGRAM_SESSION_FILE=/work/telegram/telegram.session
#TELEGRAM_STAGING_DIR=/work/staging/telegram
#TELEGRAM_LEDGER_FILE=/work/telegram_processed_ids.txt
#TELEGRAM_WATERMARK_FILE=/work/telegram_watermark.txt
#   Optional: point Telegram filing at a different (even local) LLM - chat volume
#   is the quota driver, so a cheaper/local model here saves the most.
#TELEGRAM_LLM_BASE_URL=
#TELEGRAM_LLM_API_KEY=
#TELEGRAM_LLM_MODEL=

# --- WhatsApp (fourth ingestion source: run-ingest.sh whatsapp) ---
# An always-on Baileys bridge (the whatsapp-bridge container) links this pipeline
# as a WhatsApp companion device and records messages to data/whatsapp/; the
# nightly fetch_whatsapp.py reads that store. One-time setup: `docker compose up
# -d whatsapp-bridge`, then scan the QR on the dashboard Connections page from
# WhatsApp -> Linked Devices. Read-only: the bridge never sends. NOTE: WhatsApp
# does not officially support third-party clients - see the README ban-risk note.
#   Keep proposing-only (proposed.md) until placement quality looks good. Default 1.
#WHATSAPP_DRY_RUN=1
#   Ask WhatsApp to send full history to the linked device on pairing (keep your
#   phone online during the initial sync). Read by the bridge, not the fetcher.
#WHATSAPP_SYNC_FULL_HISTORY=1
#   Include/exclude by chat name or JID (comma-separated, case-insensitive). A
#   non-empty INCLUDE list is an allowlist (named chats win over the group toggle).
#   Copy exact names from the dashboard's discovered-chats list.
#WHATSAPP_INCLUDE_CHATS=
#WHATSAPP_EXCLUDE_CHATS=
#   File group chats too (one-to-one chats are always eligible).
#WHATSAPP_INCLUDE_GROUPS=1
#WHATSAPP_MAX_PER_RUN=500
#WHATSAPP_MAX_LOOPS=60
#   Nightly watermark seed: how far back to start on the FIRST run, in days.
#WHATSAPP_LOOKBACK_DAYS=0
#   One-shot explicit window (YYYY-MM-DD Singapore days, end inclusive) over the
#   messages the bridge has already captured - a stateless backfill.
#WHATSAPP_START_DATE=
#WHATSAPP_END_DATE=
#WHATSAPP_DATA_DIR=/work/whatsapp
#WHATSAPP_STAGING_DIR=/work/staging/whatsapp
#WHATSAPP_LEDGER_FILE=/work/whatsapp_processed_ids.txt
#WHATSAPP_WATERMARK_FILE=/work/whatsapp_watermark.txt
#   Optional: point WhatsApp filing at a different (even local) LLM.
#WHATSAPP_LLM_BASE_URL=
#WHATSAPP_LLM_API_KEY=
#WHATSAPP_LLM_MODEL=

# --- Agent (any OpenAI-compatible endpoint) ---
# DeepSeek:    LLM_BASE_URL=https://api.deepseek.com     LLM_MODEL=deepseek-chat
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1 LLM_MODEL=<provider/model>
# Ollama (local, free): LLM_BASE_URL=http://host.docker.internal:11434/v1
#   LLM_MODEL=<a tool-calling model you've pulled, e.g. qwen2.5:14b or llama3.1:8b>
#   LLM_API_KEY can stay blank for local servers - it isn't checked. Run
#   `ollama pull <model>` on the host first; the containers reach the host's
#   Ollama via host.docker.internal (mapped in docker-compose.yml).
#   Tip: PERSONAL_MAIL_LLM_* below lets personal mail use Ollama while the
#   digest stays on a hosted model (or vice versa).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Semantic search for chat (optional) ---
# Turns on meaning-based retrieval fused with keyword search, so paraphrased chat
# questions still find the right note. Only affects the chat assistant (nightly
# filing stays on keyword search). Blank = off. Recommended: local Ollama +
# `ollama pull nomic-embed-text`. The embeddings are cached in SEMANTIC_DB and only
# re-computed for changed notes.
#EMBED_BASE_URL=http://host.docker.internal:11434/v1
#EMBED_MODEL=nomic-embed-text
#EMBED_API_KEY=
#SEMANTIC_DB=/data/semantic_index.db

# --- Vault Q&A web UI (persistent chat, LAN-only, no auth - same posture as the
# Obsidian GUI below) ---
VAULT_QA_PORT=8420
VAULT_QA_MAX_TURNS=20
# Optional: give the chat a stronger model than nightly filing (falls back to the
# global LLM_* vars). Applies after a restart.
#VAULT_QA_LLM_BASE_URL=
#VAULT_QA_LLM_API_KEY=
#VAULT_QA_LLM_MODEL=
# Size of the live-session cache. Chats are persisted to VAULT_QA_DB (SQLite)
# and revived on demand, so eviction/restart never loses history.
VAULT_QA_MAX_SESSIONS=50
VAULT_QA_DB=/data/sessions.db
# search_relevant freshness boost: BM25 scores decay with note age, halving
# every HALFLIFE days but never below FLOOR (0-1) of the raw score. Raise the
# half-life (or set FLOOR=1 to disable) if old reference notes rank too low.
VAULT_QA_RECENCY_HALFLIFE_DAYS=90
VAULT_QA_RECENCY_FLOOR=0.5
# Raw-archive demotion: search score multiplier (0-1) for chunks under the raw
# archive folders (Raw Digests / Raw Email / Raw Chats), so the distilled note
# wins over the wordy raw dump it came from at similar relevance. The raw dumps
# stay searchable for "what exactly was said" questions. 1 disables; 0 excludes.
#VAULT_QA_RAW_DEMOTE=0.4

# --- Stitch pass (nightly cross-source correlation: run-stitch.sh, 05:30 SGT) ---
# Correlates the notes the four sources filed last night, cross-links related
# notes, and reports duplicate-note merge candidates + filing oddities to
# data/staging/stitch/proposed.md. Merges are NEVER applied, only proposed.
#   0 (default) = report-only: proposed links land in the report, vault untouched.
#   1 = live: the agent may append "See also: [[...]]" lines to vault notes.
#STITCH_APPLY_LINKS=0
#   How many of last night's touched notes it examines per run (newest first).
#STITCH_MAX_TOPICS=20
#   Max tool-calling turns for the stitch agent.
#STITCH_MAX_LOOPS=40

# --- Safety ---
# 1 = the agent writes proposals to staging/proposed.md only, vault is never touched.
# Flip to 0 only after M3 dry-run placement quality is consistently correct.
DRY_RUN=1
BACKUP_RETENTION_DAYS=14

# Only set this if you're using the dockerized `obsidian` service (headless-server
# deployment, no desktop GUI). Leave blank if a native Obsidian desktop app already
# handles Sync for a bind-mounted vault (e.g. on your own PC).
OBSIDIAN_HEALTHCHECK_URL=

# --- Notifications (ntfy.sh) ---
# Pick any secret topic name, e.g. https://ntfy.sh/copilot-digest-a1b2c3
# Subscribe to it in the ntfy phone app.
NTFY_TOPIC=
